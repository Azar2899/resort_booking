{
 "doctype": "DocType",
 "name": "Resort Resource",
 "module": "Resort Booking",
 "custom": 0,
 "engine": "InnoDB",
 "autoname": "field:resource_name",
 "allow_rename": 1,
 "field_order": [
  "resource_name",
  "resource_type",
  "capacity",
  "column_break_4",
  "operating_hours_from",
  "operating_hours_to",
  "description"
 ],
 "fields": [
  {
   "fieldname": "resource_name",
   "fieldtype": "Data",
   "label": "Resource Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "resource_type",
   "fieldtype": "Select",
   "label": "Resource Type",
   "options": "Pool\nGame Zone\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "capacity",
   "fieldtype": "Int",
   "label": "Capacity",
   "default": "1",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Max number of guests/bookings allowed in the same time slot"
  },
  {
   "fieldname": "column_break_4",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "operating_hours_from",
   "fieldtype": "Time",
   "label": "Operating Hours From",
   "default": "06:00:00",
   "reqd": 1
  },
  {
   "fieldname": "operating_hours_to",
   "fieldtype": "Time",
   "label": "Operating Hours To",
   "default": "22:00:00",
   "reqd": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "Description"
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1
  },
  {
   "role": "Resort Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1
  },
  {
   "role": "Receptionist",
   "read": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC"
}
